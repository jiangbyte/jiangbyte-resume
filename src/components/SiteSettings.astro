---
import {
  FONT_PRESET_LABELS,
  FONT_PRESETS,
  MOTION_HINTS,
} from '@/data/site';
---

<div
  id="settings-panel"
  class="pointer-events-auto absolute bottom-[calc(100%+0.75rem)] right-0 z-10 hidden w-[20rem] origin-bottom-right rounded-2xl border border-border/80 bg-background/95 shadow-[var(--capsule-shadow)] backdrop-blur-xl sm:w-[22rem]"
  role="dialog"
  aria-label="设置"
  hidden
>
  <div class="flex items-center justify-between border-b border-border/60 px-4 py-3">
    <h2 class="text-sm font-semibold text-foreground">设置</h2>
    <button
      type="button"
      data-action="close"
      class="inline-flex size-7 items-center justify-center rounded-full text-muted-foreground transition hover:bg-accent hover:text-foreground"
      aria-label="关闭设置面板"
    >
      <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
  </div>

  <div class="px-4 pt-3">
    <div class="flex rounded-lg bg-muted/80 p-1 text-xs" role="tablist" aria-label="设置分类">
      <button type="button" data-tab="reader" class="settings-tab flex-1 rounded-md px-3 py-1.5 font-medium" role="tab"
        >阅读</button
      >
      <button type="button" data-tab="general" class="settings-tab flex-1 rounded-md px-3 py-1.5 font-medium" role="tab"
        >通用</button
      >
    </div>
  </div>

  <div class="max-h-[min(60dvh,28rem)] overflow-y-auto px-4 py-3">
    <div data-panel="reader" class="space-y-4" hidden>
      <section class="space-y-2">
        <h3 class="text-xs font-medium text-muted-foreground">字体</h3>
        <div class="flex flex-wrap gap-1">
          {
            FONT_PRESETS.map((preset) => (
              <button type="button" data-font={preset} class="seg-btn">
                {FONT_PRESET_LABELS[preset]}
              </button>
            ))
          }
          <button type="button" data-font="local" class="seg-btn">{FONT_PRESET_LABELS.local}</button>
        </div>
      </section>

      <section class="flex items-center justify-between gap-3 border-t border-border/50 pt-3">
        <span class="text-sm text-foreground">字号</span>
        <div class="flex items-center gap-1">
          <button type="button" data-step="fontSize" data-delta="-1" class="step-btn" aria-label="减小字号">−</button>
          <span data-display="fontSize" class="min-w-14 text-center text-sm tabular-nums text-muted-foreground"
            >16 px</span
          >
          <button type="button" data-step="fontSize" data-delta="1" class="step-btn" aria-label="增大字号">+</button>
        </div>
      </section>

      <section class="flex items-center justify-between gap-3 border-t border-border/50 pt-3">
        <span class="text-sm text-foreground">行距</span>
        <div class="flex items-center gap-1">
          <button type="button" data-step="lineHeight" data-delta="-1" class="step-btn" aria-label="减小行距">−</button>
          <span data-display="lineHeight" class="min-w-14 text-center text-sm tabular-nums text-muted-foreground"
            >1.8</span
          >
          <button type="button" data-step="lineHeight" data-delta="1" class="step-btn" aria-label="增大行距">+</button>
        </div>
      </section>

      <section class="flex items-center justify-between gap-3 border-t border-border/50 pt-3">
        <span class="text-sm text-foreground">行宽</span>
        <div class="flex items-center gap-1">
          <button type="button" data-step="measure" data-delta="-1" class="step-btn" aria-label="减小行宽">−</button>
          <span data-display="measure" class="min-w-14 text-center text-sm tabular-nums text-muted-foreground"
            >自动</span
          >
          <button type="button" data-step="measure" data-delta="1" class="step-btn" aria-label="增大行宽">+</button>
        </div>
      </section>

      <section class="flex items-center justify-between gap-3 border-t border-border/50 pt-3">
        <span class="text-sm text-foreground">两端对齐</span>
        <button type="button" data-toggle="justify" class="switch" role="switch" aria-checked="false"></button>
      </section>

      <div class="border-t border-border/50 pt-3">
        <button
          type="button"
          data-action="reset-reader"
          class="w-full rounded-lg border border-border/80 px-3 py-2 text-sm text-muted-foreground transition hover:bg-accent hover:text-foreground"
        >
          重置为默认
        </button>
      </div>
    </div>

    <div data-panel="general" class="space-y-4">
      <section class="space-y-2">
        <h3 class="text-xs font-medium text-muted-foreground">外观</h3>
        <div class="flex flex-wrap gap-1">
          <button type="button" data-theme="light" class="seg-btn">浅色</button>
          <button type="button" data-theme="dark" class="seg-btn">深色</button>
          <button type="button" data-theme="system" class="seg-btn">跟随系统</button>
        </div>
      </section>

      <section class="flex items-center justify-between gap-3 border-t border-border/50 pt-3">
        <span class="text-sm text-foreground">滚动进度条</span>
        <button type="button" data-toggle="scrollProgress" class="switch" role="switch" aria-checked="true"></button>
      </section>

      <section class="space-y-2 border-t border-border/50 pt-3">
        <h3 class="text-sm text-foreground">动效强度</h3>
        <div class="flex flex-wrap gap-1">
          <button type="button" data-motion="lively" class="seg-btn">灵动</button>
          <button type="button" data-motion="subtle" class="seg-btn">克制</button>
          <button type="button" data-motion="reduced" class="seg-btn">减弱</button>
        </div>
        <p data-motion-hint class="text-[11px] leading-relaxed text-muted-foreground/85">{MOTION_HINTS.lively}</p>
        <p data-motion-system class="hidden text-[11px] leading-relaxed text-amber-600/90 dark:text-amber-400/90">
          系统已开启「减少动态效果」，将始终按「减弱」处理
        </p>
      </section>

      <section class="flex items-center justify-between gap-3 border-t border-border/50 pt-3">
        <span class="text-sm text-foreground">雪花特效</span>
        <button type="button" data-toggle="snow" class="switch" role="switch" aria-checked="true"></button>
      </section>
    </div>
  </div>
</div>

<script>
  import { FONT_PRESETS, MOTION_HINTS, type MotionLevel } from '@/data/site';
  import {
    applyAllPrefs,
    getFontPreset,
    getFontSize,
    getJustify,
    getLineHeight,
    getLocalFont,
    getMeasure,
    getMotionChoice,
    getScrollProgress,
    getSnow,
    getTheme,
    READER_CUSTOM_MEASURE,
    resetReaderPreferences,
    setFontPreset,
    setFontSize,
    setJustify,
    setLineHeight,
    setLocalFont,
    setMeasure,
    setMotion,
    setScrollProgress,
    setSnow,
    setTheme,
  } from '@/lib/prefs';

  const panel = document.getElementById('settings-panel');
  if (!panel) throw new Error('settings-panel missing');

  function emit() {
    applyAllPrefs();
    window.dispatchEvent(new Event('home:prefs-change'));
  }

  function isOpen() {
    return !panel.classList.contains('hidden');
  }

  function setOpen(open: boolean) {
    panel.hidden = !open;
    panel.classList.toggle('hidden', !open);
    document.getElementById('fab-settings')?.setAttribute('aria-expanded', String(open));
    if (open) {
      syncUI();
      setTab('general');
    }
  }

  function setTab(tab: 'reader' | 'general') {
    panel.querySelectorAll<HTMLElement>('[data-tab]').forEach((btn) => {
      btn.dataset.active = String(btn.dataset.tab === tab);
    });
    panel.querySelectorAll<HTMLElement>('[data-panel]').forEach((el) => {
      el.hidden = el.dataset.panel !== tab;
    });
  }

  function setSwitch(name: string, on: boolean) {
    const btn = panel.querySelector<HTMLButtonElement>(`[data-toggle="${name}"]`);
    if (!btn) return;
    btn.dataset.on = String(on);
    btn.setAttribute('aria-checked', String(on));
  }

  function syncUI() {
    const local = getLocalFont();
    const preset = getFontPreset();
    panel.querySelectorAll<HTMLButtonElement>('[data-font]').forEach((btn) => {
      const v = btn.dataset.font;
      btn.dataset.active = String(local ? v === 'local' : v === preset);
    });

    const fontSizeEl = panel.querySelector('[data-display="fontSize"]');
    const lineHeightEl = panel.querySelector('[data-display="lineHeight"]');
    const measureEl = panel.querySelector('[data-display="measure"]');
    const measure = getMeasure();
    if (fontSizeEl) fontSizeEl.textContent = `${getFontSize()} px`;
    if (lineHeightEl) lineHeightEl.textContent = String(getLineHeight());
    if (measureEl) measureEl.textContent = measure === null ? '自动' : `${measure} ch`;

    const theme = getTheme();
    panel.querySelectorAll<HTMLButtonElement>('[data-theme]').forEach((btn) => {
      btn.dataset.active = String(btn.dataset.theme === theme);
    });

    const motion = getMotionChoice();
    panel.querySelectorAll<HTMLButtonElement>('[data-motion]').forEach((btn) => {
      btn.dataset.active = String(btn.dataset.motion === motion);
    });
    const hint = panel.querySelector('[data-motion-hint]');
    if (hint) hint.textContent = MOTION_HINTS[motion];
    panel
      .querySelector('[data-motion-system]')
      ?.classList.toggle('hidden', !window.matchMedia('(prefers-reduced-motion: reduce)').matches);

    setSwitch('justify', getJustify());
    setSwitch('scrollProgress', getScrollProgress());
    setSwitch('snow', getSnow());

    const snowBtn = panel.querySelector<HTMLButtonElement>('[data-toggle="snow"]');
    if (snowBtn) {
      const disabled = motion === 'reduced' || window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      snowBtn.disabled = disabled;
      snowBtn.classList.toggle('opacity-40', disabled);
    }
  }

  function handlePanelClick(event: MouseEvent) {
    // 1. 只处理面板内部点击；用 closest 找到实际控件
    const target = event.target;
    if (!(target instanceof Element)) return;
    const control = target.closest<HTMLElement>(
      '[data-action], [data-tab], [data-font], [data-theme], [data-motion], [data-step], [data-toggle]',
    );
    if (!control || !panel.contains(control)) return;

    event.preventDefault();
    event.stopPropagation();

    // 2. 关闭 / 重置
    if (control.dataset.action === 'close') {
      setOpen(false);
      return;
    }
    if (control.dataset.action === 'reset-reader') {
      resetReaderPreferences();
      emit();
      syncUI();
      return;
    }

    // 3. 分栏
    if (control.dataset.tab === 'reader' || control.dataset.tab === 'general') {
      setTab(control.dataset.tab);
      return;
    }

    // 4. 字体
    const font = control.dataset.font;
    if (font === 'local') {
      const name = window.prompt('输入本机字体名称（例如：霞鹜文楷）', getLocalFont() ?? '');
      if (name) {
        setLocalFont(name);
        emit();
        syncUI();
      }
      return;
    }
    if (font && FONT_PRESETS.includes(font as (typeof FONT_PRESETS)[number])) {
      setFontPreset(font as (typeof FONT_PRESETS)[number]);
      emit();
      syncUI();
      return;
    }

    // 5. 主题 / 动效
    const theme = control.dataset.theme;
    if (theme === 'light' || theme === 'dark' || theme === 'system') {
      setTheme(theme);
      emit();
      syncUI();
      return;
    }
    const motion = control.dataset.motion as MotionLevel | undefined;
    if (motion === 'lively' || motion === 'subtle' || motion === 'reduced') {
      setMotion(motion);
      emit();
      syncUI();
      return;
    }

    // 6. 步进（data-delta 避免 data-dir 与方向属性混淆）
    if (control.dataset.step) {
      const delta = Number(control.dataset.delta);
      const step = Number.isFinite(delta) && delta !== 0 ? delta : 1;
      if (control.dataset.step === 'fontSize') {
        setFontSize(Math.min(24, Math.max(12, getFontSize() + step)));
      } else if (control.dataset.step === 'lineHeight') {
        const next = Math.round((getLineHeight() + step * 0.1) * 10) / 10;
        setLineHeight(Math.min(2.4, Math.max(1.2, next)));
      } else if (control.dataset.step === 'measure') {
        const cur = getMeasure();
        if (cur === null) {
          if (step > 0) setMeasure(READER_CUSTOM_MEASURE);
        } else if (step < 0 && cur <= READER_CUSTOM_MEASURE) {
          setMeasure(null);
        } else {
          setMeasure(Math.max(30, Math.min(120, cur + step * 5)));
        }
      }
      emit();
      syncUI();
      return;
    }

    // 7. 开关
    const toggle = control.dataset.toggle;
    if (toggle === 'justify') setJustify(!getJustify());
    else if (toggle === 'scrollProgress') setScrollProgress(!getScrollProgress());
    else if (toggle === 'snow') setSnow(!getSnow());
    else return;
    emit();
    syncUI();
  }

  // 面板内点击：直接绑在 panel 上，避免 document 委托漏点 / 被抢
  panel.addEventListener('click', handlePanelClick);

  // 浮动齿轮：打开 / 关闭
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    if (target.closest('[data-settings-toggle]')) {
      event.preventDefault();
      event.stopPropagation();
      setOpen(!isOpen());
      return;
    }
    // 点面板外关闭
    if (isOpen() && !target.closest('#settings-panel')) {
      setOpen(false);
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && isOpen()) setOpen(false);
  });

  applyAllPrefs();
  syncUI();
</script>

<style>
  .settings-tab[data-active='true'] {
    background: hsl(var(--background));
    color: hsl(var(--foreground));
    box-shadow: 0 1px 2px rgb(40 60 90 / 0.08);
  }

  .settings-tab:not([data-active='true']) {
    color: hsl(var(--muted-foreground));
  }

  .seg-btn {
    position: relative;
    border-radius: 0.375rem;
    background: hsl(var(--muted));
    padding: 0.25rem 0.625rem;
    font-size: 0.75rem;
    color: hsl(var(--muted-foreground));
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }

  .seg-btn:hover {
    background: hsl(var(--accent));
    color: hsl(var(--accent-foreground));
  }

  .seg-btn[data-active='true'] {
    background: hsl(var(--primary));
    color: hsl(var(--primary-foreground));
  }

  .step-btn {
    display: inline-flex;
    width: 1.75rem;
    height: 1.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.375rem;
    background: hsl(var(--muted));
    font-size: 0.875rem;
    line-height: 1;
    color: hsl(var(--foreground));
    cursor: pointer;
    user-select: none;
  }

  .step-btn:hover {
    background: hsl(var(--accent));
  }

  .step-btn:active {
    transform: scale(0.94);
  }

  .switch {
    position: relative;
    width: 2.5rem;
    height: 1.4rem;
    flex-shrink: 0;
    border-radius: 9999px;
    background: hsl(var(--muted));
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .switch::after {
    content: '';
    position: absolute;
    top: 0.15rem;
    left: 0.15rem;
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 9999px;
    background: white;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.15);
    transition: translate 0.2s ease;
  }

  .switch[data-on='true'] {
    background: hsl(var(--primary));
  }

  .switch[data-on='true']::after {
    translate: 1.1rem 0;
  }
</style>
