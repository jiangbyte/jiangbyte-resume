---
import Snowflake from '@/components/Snowflake.astro';
import { siteMeta } from '@/data/projects';

const currentYear = new Date().getFullYear();
const startYear = siteMeta.startYear;
const yearLabel = startYear !== currentYear ? `${startYear}-${currentYear}` : String(startYear);
---

<footer class="relative z-10 mt-auto pb-8 pt-4">
  <div class="mx-auto flex w-full max-w-[48rem] flex-col items-center gap-2.5 px-6 text-center">
    <p class="flex flex-wrap items-center justify-center gap-x-1 text-xs text-muted-foreground opacity-80 sm:text-sm">
      <span>©</span>
      <span class="font-medium">{yearLabel}</span>
      <Snowflake class="mx-0.5 size-4 animate-spin text-[#9ec8ef] [animation-duration:10s]" />
      <span class="font-medium">{siteMeta.name}</span>
      <span>. All rights reserved.</span>
    </p>

    <p
      class="flex flex-col items-center gap-y-1 text-xs text-muted-foreground/80 opacity-80 sm:flex-row sm:flex-wrap sm:justify-center sm:gap-x-2 sm:text-sm"
    >
      <a
        href={siteMeta.icp.link}
        target="_blank"
        rel="noopener noreferrer"
        class="footer-link font-medium"
      >
        {siteMeta.icp.text}
      </a>
      <span class="hidden opacity-40 sm:inline" aria-hidden="true">|</span>
      <a
        href={siteMeta.police.link}
        target="_blank"
        rel="noopener noreferrer"
        class="footer-link inline-flex items-center gap-1 font-medium"
      >
        <img src={siteMeta.police.icon} alt="" width="14" height="14" class="inline-block" />
        {siteMeta.police.text}
      </a>
    </p>

    <p class="flex flex-wrap items-center justify-center gap-x-1.5 text-xs text-muted-foreground/70 opacity-75 sm:text-sm">
      <span>Built with</span>
      <a
        href="https://astro.build"
        target="_blank"
        rel="noopener noreferrer"
        class="footer-link font-medium"
      >
        Astro
      </a>
      <span class="opacity-40" aria-hidden="true">·</span>
      <span>{siteMeta.title}</span>
    </p>
  </div>
</footer>

<style>
  .footer-link {
    opacity: 0.75;
    position: relative;
  }

  .footer-link:hover {
    opacity: 1;
  }

  .footer-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1px;
    background: currentColor;
    transition: width 0.3s ease;
  }

  .footer-link:hover::after {
    width: 100%;
  }
</style>
