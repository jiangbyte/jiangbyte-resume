---
import Icon from '@/components/Icon.astro';
import { githubAvatar, links } from '@/data/projects';
import { contact, profile } from '@/data/resume';

const contactItems = [
  {
    label: contact.email,
    href: `mailto:${contact.email}`,
    icon: 'mail' as const,
    external: false,
  },
  {
    label: contact.wechat,
    href: undefined,
    icon: 'wechat' as const,
    external: false,
    title: `微信 ${contact.wechat}（${contact.wechatNote}）`,
  },
  {
    label: 'jiangbyte',
    href: contact.github,
    icon: 'github' as const,
    external: true,
  },
  {
    label: '博客',
    href: links.blog,
    icon: 'blog' as const,
    external: false,
  },
];
---

<section class="mx-auto w-full px-6 pb-10 pt-28 sm:pt-32">
  {/* 移动端：头像在上、内容居中；桌面：文左图右 */}
  <div class="flex flex-col items-center gap-8 sm:flex-row-reverse sm:items-start sm:justify-between sm:gap-10">
    <img
      src={githubAvatar.src}
      width="120"
      height="120"
      alt={`${profile.name}（@${githubAvatar.user}）`}
      class="size-24 shrink-0 rounded-full bg-muted object-cover shadow-[var(--capsule-shadow)] ring-2 ring-primary/20 sm:size-[7.5rem]"
      loading="eager"
      decoding="async"
    />

    <div class="min-w-0 flex-1 text-center sm:text-left">
      <h1 class="text-4xl font-semibold tracking-tight text-foreground sm:text-5xl">{profile.name}</h1>
      <p class="mt-3 text-base text-foreground/90 sm:text-lg">
        {profile.role}
        <span class="mx-2 text-border">·</span>
        <span class="text-muted-foreground">{profile.location}</span>
        <span class="mx-2 text-border">·</span>
        <span class="text-muted-foreground">{profile.education}</span>
      </p>
      <p class="body-text mx-auto mt-4 max-w-2xl text-muted-foreground sm:mx-0">{profile.summary}</p>

      <ul
        class="mt-6 flex flex-col items-center gap-y-2.5 text-sm text-muted-foreground sm:flex-row sm:flex-wrap sm:items-center sm:justify-start sm:gap-x-4"
        aria-label="联系方式"
      >
        {
          contactItems.map((item) => (
            <li>
              {item.href ? (
                <a
                  href={item.href}
                  class="inline-flex items-center gap-1.5 transition hover:text-primary"
                  title={item.title ?? item.label}
                  rel={item.external ? 'noopener noreferrer' : undefined}
                  target={item.external ? '_blank' : undefined}
                >
                  <Icon name={item.icon} class="size-5 shrink-0" />
                  <span>{item.label}</span>
                </a>
              ) : (
                <span class="inline-flex items-center gap-1.5" title={item.title}>
                  <Icon name={item.icon} class="size-5 shrink-0" />
                  <span class="text-foreground/85">{item.label}</span>
                </span>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
