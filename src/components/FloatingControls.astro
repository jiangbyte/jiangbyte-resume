---
import SiteSettings from '@/components/SiteSettings.astro';
---

{/* 同一 relative 容器：面板锚在按钮组上方，避免 absolute 找不到参照 */}
<div
  class="pointer-events-none fixed bottom-5 right-5 z-50 sm:bottom-8 sm:right-8"
>
  <div class="relative flex flex-col items-end gap-2">
    <SiteSettings />
    <div class="pointer-events-auto flex flex-col gap-2">
      <button
        type="button"
        id="fab-settings"
        data-settings-toggle
        class="fab-btn text-primary"
        aria-label="设置"
        aria-expanded="false"
        aria-controls="settings-panel"
        title="设置"
      >
        <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M19.14 12.94c.04-.31.06-.63.06-.94s-.02-.63-.06-.94l2.03-1.58a.5.5 0 0 0 .12-.64l-1.92-3.32a.5.5 0 0 0-.6-.22l-2.39.96a7.07 7.07 0 0 0-1.63-.94l-.36-2.54a.5.5 0 0 0-.5-.42h-3.84a.5.5 0 0 0-.5.42l-.36 2.54c-.59.24-1.13.55-1.63.94l-2.39-.96a.5.5 0 0 0-.6.22L2.71 8.84a.5.5 0 0 0 .12.64l2.03 1.58c-.04.31-.06.63-.06.94s.02.63.06.94L2.83 14.5a.5.5 0 0 0-.12.64l1.92 3.32c.14.24.43.34.68.24l2.39-.96c.5.39 1.04.7 1.63.94l.36 2.54c.05.24.26.42.5.42h3.84c.24 0 .45-.18.5-.42l.36-2.54c.59-.24 1.13-.55 1.63-.94l2.39.96c.25.1.54 0 .68-.24l1.92-3.32a.5.5 0 0 0-.12-.64l-2.03-1.58ZM12 15.6A3.6 3.6 0 1 1 12 8.4a3.6 3.6 0 0 1 0 7.2Z"
          ></path>
        </svg>
      </button>
      <button type="button" id="fab-top" class="fab-btn" aria-label="回到顶部" title="回到顶部">
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"></path>
        </svg>
      </button>
      <button type="button" id="fab-bottom" class="fab-btn" aria-label="前往底部" title="前往底部">
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
        </svg>
      </button>
    </div>
  </div>
</div>

<script>
  const behavior = () =>
    document.documentElement.dataset.motion === 'reduced' ||
    window.matchMedia('(prefers-reduced-motion: reduce)').matches
      ? 'auto'
      : 'smooth';

  document.getElementById('fab-top')?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: behavior() });
  });
  document.getElementById('fab-bottom')?.addEventListener('click', () => {
    window.scrollTo({ top: document.documentElement.scrollHeight, behavior: behavior() });
  });
</script>

<style>
  .fab-btn {
    display: inline-flex;
    width: 2.5rem;
    height: 2.5rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: color-mix(in oklab, hsl(var(--background)) 85%, transparent);
    color: hsl(var(--foreground));
    box-shadow:
      0 6px 16px -8px rgb(107 168 224 / 0.45),
      0 2px 6px -3px rgb(40 60 90 / 0.12);
    outline: 1px solid hsl(var(--primary) / 0.1);
    backdrop-filter: blur(12px);
    transition:
      translate 0.3s ease,
      outline-color 0.3s ease;
  }

  .fab-btn:hover {
    translate: 0 -2px;
    outline-color: hsl(var(--primary) / 0.25);
  }

  .fab-btn:active {
    scale: 0.92;
  }
</style>
