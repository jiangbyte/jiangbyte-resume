---
import { experience } from '@/data/resume';
---

<section id="experience" class="mx-auto w-full scroll-mt-24 px-6 pb-8">
  <h2 class="text-xl font-semibold tracking-tight text-foreground">个人经历</h2>

  {/* 连续时间轴：左侧贯穿竖线串联各段经历 */}
  <ol class="relative mt-6 space-y-0 border-l border-primary/25 pl-6 sm:pl-7">
    {
      experience.map((job, index) => (
        <li class={`relative ${index === experience.length - 1 ? 'pb-0' : 'pb-8'}`}>
          <span
            class:list={[
              'absolute -left-[calc(1.5rem+4.5px)] top-1.5 size-2.5 rounded-full border-2 border-primary bg-background sm:-left-[calc(1.75rem+4.5px)]',
              index === 0 && 'bg-primary',
            ]}
            aria-hidden="true"
          />
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-0.5">
            <h3 class="text-base font-semibold text-foreground">{job.title}</h3>
            <time class="text-xs text-muted-foreground sm:text-sm">{job.period}</time>
          </div>
          <p class="body-text mt-1.5 text-muted-foreground">{job.summary}</p>
          <ul class="mt-2.5 space-y-1.5">
            {job.highlights.map((item) => (
              <li class="body-text flex gap-2 text-foreground/85">
                <span class="mt-[0.7em] size-1 shrink-0 rounded-full bg-primary/45" aria-hidden="true" />
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ol>
</section>
