---
import { links, siteMeta } from '@/data/projects';
---

<header class="pointer-events-none fixed inset-x-0 top-0 z-50 px-4 pt-3 sm:px-6">
  <div
    class="pointer-events-auto mx-auto flex w-full max-w-[48rem] items-center justify-between gap-3 rounded-full border border-primary/15 px-3.5 py-2 shadow-[var(--capsule-shadow)] backdrop-blur-xl sm:px-4"
    style="background: var(--capsule-bg);"
  >
    <a href="/" class="shrink-0 text-sm font-semibold tracking-wide text-foreground">
      {siteMeta.title}
    </a>

    <nav class="flex items-center gap-0.5 text-sm text-muted-foreground" aria-label="主导航">
      <a
        href="#experience"
        class="hidden rounded-full px-2.5 py-1 transition-colors hover:bg-accent hover:text-accent-foreground sm:inline"
        >个人经历</a
      >
      <a
        href="#skills"
        class="hidden rounded-full px-2.5 py-1 transition-colors hover:bg-accent hover:text-accent-foreground md:inline"
        >技术</a
      >
      <a
        href="#projects"
        class="rounded-full px-2.5 py-1 transition-colors hover:bg-accent hover:text-accent-foreground"
        >项目</a
      >
      <a
        href={links.blog}
        class="rounded-full px-2.5 py-1 transition-colors hover:bg-accent hover:text-accent-foreground"
        >博客</a
      >
    </nav>
  </div>
</header>
