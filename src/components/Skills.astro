---
import { skills } from '@/data/resume';
---

<section id="skills" class="mx-auto w-full scroll-mt-24 px-6 pb-8">
  <h2 class="text-xl font-semibold tracking-tight text-foreground">技术栈</h2>

  <dl class="mt-4 space-y-3">
    {
      skills.map((group) => (
        <div class="flex flex-col gap-1 sm:flex-row sm:gap-4">
          <dt class="w-14 shrink-0 pt-0.5 text-sm font-medium text-primary">{group.label}</dt>
          <dd class="body-text text-muted-foreground">{group.items.join(' · ')}</dd>
        </div>
      ))
    }
  </dl>
</section>
